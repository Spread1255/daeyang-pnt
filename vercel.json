    }
  ],
  "rewrites": [
    {
      "source": "/company",
      "destination": "/about.html"
    },
    {
      "source": "/vision",
      "destination": "/about-vision.html"
    },
    {
      "source": "/company-info",
      "destination": "/about-info.html"
    },
    {
      "source": "/history",
      "destination": "/about-history.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/applications",
      "destination": "/applications.html"
    },
    {
      "source": "/colors",
      "destination": "/colors.html"
    },
    {
      "source": "/colorbook",
      "destination": "/colorbook.html"
    },
    {
      "source": "/colorlab",
      "destination": "/colorlab.html"
    },
    {
      "source": "/msds",
      "destination": "/msds.html"
    },
    {
      "source": "/certificates",
      "destination": "/resources.html"
    },
    {
      "source": "/notice",
      "destination": "/notices.html"
    },
    {
      "source": "/partnership",
      "destination": "/partnership.html"
    },
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/manager/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
